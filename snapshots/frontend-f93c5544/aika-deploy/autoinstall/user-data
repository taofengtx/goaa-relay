#cloud-config
autoinstall:
  version: 1
  locale: zh_TW.UTF-8
  keyboard:
    layout: us
  identity:
    hostname: goaa-node
    username: goaa
    password: "goaa2024"
    realname: goaa Agent
  ssh:
    install-server: true
    allow-pw: true
  storage:
    layout:
      name: direct
  packages:
    - python3
    - python3-pip
    - python3-venv
    - git
    - curl
    - wget
    - chromium-browser
    - psutil
  user-data:
    disable_root: false
  late-commands:
    - wget -O /target/opt/goaa_setup.sh https://raw.githubusercontent.com/taofengtx/goaa-ai-frontend/main/geekom-deploy/scripts/setup.sh
    - chmod +x /target/opt/goaa_setup.sh
    - curtin in-target --target=/target -- bash /opt/goaa_setup.sh
