[Unit]  
Description=GOAA.AI Heartbeat Daemon  
After=network.target  
[Service]  
Type=simple  
User=goaa  
WorkingDirectory=/opt/goaa-ai-frontend  
ExecStart=/usr/bin/python3 /opt/goaa-ai-frontend/scripts/heartbeat_runtime.py  
Restart=always  
RestartSec=10  
StandardOutput=journal  
StandardError=journal  
[Install]  
WantedBy=multi-user.target  
