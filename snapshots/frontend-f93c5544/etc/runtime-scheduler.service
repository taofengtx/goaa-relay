[Unit]  
Description=GOAA.AI Runtime Scheduler  
After=network.target heartbeat-daemon.service  
Wants=heartbeat-daemon.service  
 
[Service]  
Type=simple  
User=goaa  
WorkingDirectory=/opt/goaa-ai-frontend  
ExecStart=/usr/bin/python3 /opt/goaa-ai-frontend/scripts/runtime_scheduler_exec.py  
Restart=always  
RestartSec=15  
StandardOutput=journal  
StandardError=journal  
Environment="PYTHONUNBUFFERED=1"  
 
[Install]  
WantedBy=multi-user.target  
