#!/bin/bash
# AiKa Node v1.0.5 postinst
# 禁止任何 apt/apt-get/dpkg 調用
# 所有系統依賴已在 DEBIAN/control Depends 聲明

set -e

VERSION="1.0.5"
GOAA_DIR="/opt/goaa"
ROUTER_API="http://134.199.227.108:8080"
LOG_FILE="/var/log/aika-install.log"

log() { echo "[$(date '+%H:%M:%S')] $1" | tee -a "$LOG_FILE"; }

echo ""
echo "╔══════════════════════════════════════════════════════╗"
echo "║     🦞  AiKa Box v$VERSION  初始化中                  ║"
echo "╚══════════════════════════════════════════════════════╝"

# ── Step 1：目錄結構 ─────────────────────────────────────────
log "1/7 建立目錄..."
mkdir -p "$GOAA_DIR"/{logs,data,config,downloads,runtime,workers}
mkdir -p "$GOAA_DIR"/logs/{tasks,revenue,router,errors,workers}
chmod 755 "$GOAA_DIR"

# ── Step 2：Python venv（python3-venv 已由 Depends 保證）────
log "2/7 建立 Python 環境..."
if [ ! -f "$GOAA_DIR/venv/bin/activate" ]; then
    python3 -m venv "$GOAA_DIR/venv"
fi
"$GOAA_DIR/venv/bin/pip" install -q --upgrade pip
"$GOAA_DIR/venv/bin/pip" install -q \
    fastapi uvicorn httpx websockets \
    python-multipart aiofiles psutil requests bcrypt

# ── Step 3：從 GitHub 同步（git 已由 Depends 保證）──────────
log "3/7 同步 GOAA.AI 配置..."
if [ -d "$GOAA_DIR/repo/.git" ]; then
    cd "$GOAA_DIR/repo" && git pull origin main -q 2>/dev/null || true
else
    git clone https://github.com/taofengtx/goaa-ai-frontend.git \
        "$GOAA_DIR/repo" -q 2>/dev/null || true
fi

# ── Step 4：自動生成節點身份 ─────────────────────────────────
log "4/7 生成節點 ID..."
LOCAL_IP=$(ip route get 1 2>/dev/null | awk '{print $7}' | head -1 || echo "unknown")
IFACE=$(ip route get 1 2>/dev/null | awk '{print $5}' | head -1 || echo "eth0")
MAC_RAW=$(cat "/sys/class/net/$IFACE/address" 2>/dev/null | tr -d ':' || echo "000001")
NODE_ID="AKB-${MAC_RAW: -8}"
NODE_ID=$(echo "$NODE_ID" | tr '[:lower:]' '[:upper:]')
CPU_CORES=$(nproc 2>/dev/null || echo "2")
RAM_GB=$(free -g 2>/dev/null | awk '/^Mem:/{print $2}' || echo "4")

cat > "$GOAA_DIR/registration.json" << REGEOF
{
  "node_id": "$NODE_ID",
  "hostname": "$(hostname)",
  "ip": "$LOCAL_IP",
  "role": "edge_worker",
  "aika_version": "$VERSION",
  "status": "active",
  "registered_at": "$(date -u +%Y-%m-%dT%H:%M:%SZ)",
  "cloud_anchor": "134.199.227.108",
  "capabilities": {
    "cpu_cores": $CPU_CORES,
    "ram_gb": $RAM_GB,
    "docker": false,
    "python": true,
    "ollama": false
  }
}
REGEOF
log "節點 ID：$NODE_ID"

# ── Step 5：心跳腳本 ─────────────────────────────────────────
log "5/7 配置心跳..."
cat > "$GOAA_DIR/heartbeat.py" << PYEOF
#!/usr/bin/env python3
import requests, psutil, subprocess, json, time, os

NODE_ID  = os.getenv("NODE_ID",    "$NODE_ID")
ROUTER   = os.getenv("ROUTER_API", "$ROUTER_API")

def check(cmd):
    try: return subprocess.run(cmd, capture_output=True, timeout=5).returncode == 0
    except: return False

while True:
    try:
        requests.post(f"{ROUTER}/worker/heartbeat", timeout=8, json={
            "worker_id": NODE_ID,
            "cpu":    psutil.cpu_percent(interval=2),
            "memory": psutil.virtual_memory().percent,
            "disk":   psutil.disk_usage("/").percent,
            "docker": check(["docker","ps"]),
            "ollama": check(["curl","-sf","http://localhost:11434/api/tags"]),
        })
    except: pass
    time.sleep(30)
PYEOF
chmod +x "$GOAA_DIR/heartbeat.py"

# ── Step 6：systemd 服務 ─────────────────────────────────────
log "6/7 配置系統服務..."
cat > /etc/systemd/system/aika-heartbeat.service << SVCEOF
[Unit]
Description=AiKa Heartbeat v$VERSION
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=$GOAA_DIR/venv/bin/python3 $GOAA_DIR/heartbeat.py
Restart=always
RestartSec=30
Environment=NODE_ID=$NODE_ID
Environment=ROUTER_API=$ROUTER_API
CPUQuota=5%
MemoryMax=128M

[Install]
WantedBy=multi-user.target
SVCEOF

systemctl daemon-reload
systemctl enable aika-heartbeat 2>/dev/null
systemctl start  aika-heartbeat 2>/dev/null

# GitHub 每小時同步（cron，非 persistent）
( crontab -l 2>/dev/null | grep -v goaa-sync
  echo "0 * * * * cd $GOAA_DIR/repo && git pull origin main -q >> $GOAA_DIR/logs/sync.log 2>&1"
) | crontab -

# ── Step 7：桌面 + 開機自啟 ──────────────────────────────────
log "7/7 配置桌面環境..."
for DIR in /home/*/; do
    [ -d "$DIR" ] || continue
    UNAME=$(basename "$DIR")
    DESK="$DIR/Desktop"
    AUTO="$DIR/.config/autostart"
    mkdir -p "$DESK" "$AUTO"

    cat > "$DESK/aika-workstation.desktop" << DSKEOF
[Desktop Entry]
Version=1.0
Type=Application
Name=AiKa 工作台 v$VERSION
Exec=xdg-open https://portal.goaa.ai/agent-login
Terminal=false
DSKEOF
    chmod +x "$DESK/aika-workstation.desktop"

    cat > "$AUTO/goaa-portal.desktop" << AUTOEOF
[Desktop Entry]
Type=Application
Name=GOAA Portal
Exec=bash -c "sleep 15 && xdg-open https://portal.goaa.ai/agent-login"
X-GNOME-Autostart-enabled=true
AUTOEOF
    chown -R "$UNAME:$UNAME" "$DESK" "$AUTO" 2>/dev/null || true
done

# ── 向雲端注冊 ───────────────────────────────────────────────
curl -sf -X POST "$ROUTER_API/worker/heartbeat" \
    -H "Content-Type: application/json" \
    -d "$(cat $GOAA_DIR/registration.json)" \
    --connect-timeout 8 > /dev/null 2>&1 \
    && log "✅ 已注冊到 GOAA.AI 雲端" \
    || log "⚠️ 雲端注冊稍後重試（心跳服務會持續嘗試）"

echo ""
echo "╔══════════════════════════════════════════════════════╗"
echo "║   ✅  AiKa Box v$VERSION 安裝完成！                   ║"
printf  "║   節點 ID : %-41s║\n" "$NODE_ID"
printf  "║   IP      : %-41s║\n" "$LOCAL_IP"
echo "║                                                      ║"
echo "║   執行 sudo reboot 完成最後設置                      ║"
echo "╚══════════════════════════════════════════════════════╝"
