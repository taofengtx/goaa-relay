# GOAA production-ready environment example
# Copy to .env.local for local development. Never commit real values.

# --- Production API gateway (defaults to https://api.goaa.ai when unset) ---
# Formal Order Engine API base. In production this resolves to:
#   https://api.goaa.ai/api/v1/order
# Leave unset in production to use the secure default.
NEXT_PUBLIC_GOAA_ORDER_API_BASE=

# OpenClaw / Agent Auth gateway URL.
# In production leave unset to use https://api.goaa.ai.
# For local development against a tunnel, set the tunnel URL explicitly.
NEXT_PUBLIC_OPENCLAW_URL=

# --- Demo fallback (EXPLICIT OPT-IN for local/dev/test tooling ONLY) ---
# Formal Customer / Agent / Admin flows FAIL CLOSED unless this is exactly "true".
# Never set this to "true" in Vercel production.
NEXT_PUBLIC_GOAA_ALLOW_DEMO_FALLBACK=false

# --- Server-side Stripe (Next.js API routes only; Test Mode keys) ---
# Only needed if the frontend /api/stripe/* routes are used (legacy Connect Pass bar).
# Formal Connect Pass checkout goes through the Order Engine, not these routes.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
