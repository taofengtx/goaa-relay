# Public frontend runtime configuration (production example — values are never committed)
# Leave empty to use the secure defaults (https://api.goaa.ai).
NEXT_PUBLIC_ROUTER_URL=
NEXT_PUBLIC_OPENCLAW_URL=
# Formal Order Engine API base. Defaults to https://api.goaa.ai/api/v1/order.
NEXT_PUBLIC_GOAA_ORDER_API_BASE=
# Demo fallback MUST be "false" (or unset) in production — formal flows fail closed.
NEXT_PUBLIC_GOAA_ALLOW_DEMO_FALLBACK=false
