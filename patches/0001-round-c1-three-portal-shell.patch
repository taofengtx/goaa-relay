+/* goaa-tokens.css — GOAA UI source of truth (approved 2026-09-11).
+ * Dashboard = planning.goaa.ai workspace; sign-in = /client-login card.
+ * Load once in app/layout.tsx. /portal-preview/** must NOT import this. */
+
+:root {
+  --goaa-bg: #0d0b15;
+  --goaa-bg-elev: #111016;
+  --goaa-card: #121017;
+  --goaa-card-2: #17151e;
+  --goaa-border: #2b2533;
+  --goaa-border-strong: #393343;
+  --goaa-text: #f7f5fb;
+  --goaa-text-2: #dfd8ee;
+  --goaa-muted: #aaa5b7;
+  --goaa-muted-2: #92909f;
+  --goaa-accent: #6944cc;
+  --goaa-accent-border: #7b57e7;
+  --goaa-accent-soft: #c4b5fd;
+  --goaa-accent-bg: #21162f;
+  --goaa-accent-bg-border: #4b386f;
+  --goaa-pill: #272035;
+  --goaa-pill-text: #d7c8f6;
+  --goaa-ok-bg: #15312a;
+  --goaa-ok-text: #a8e7cb;
+  --goaa-warn: #f5b544;
+  --goaa-danger: #fca5a5;
+
+  --goaa-auth-bg: #08080c;
+  --goaa-auth-card: linear-gradient(180deg, rgba(30,30,38,.98), rgba(18,18,24,.98));
+  --goaa-auth-card-border: rgba(255,255,255,.12);
+  --goaa-auth-input-bg: rgba(255,255,255,.055);
+  --goaa-auth-input-border: rgba(255,255,255,.16);
+  --goaa-auth-btn-bg: rgba(255,255,255,.035);
+  --goaa-auth-btn-border: rgba(255,255,255,.28);
+  --goaa-auth-primary-bg: #f4f4f5;
+  --goaa-auth-primary-text: #111116;
+  --goaa-auth-muted: rgba(255,255,255,.62);
+  --goaa-auth-hairline: rgba(255,255,255,.14);
+
+  --goaa-font: Outfit, Inter, system-ui, -apple-system, 'Segoe UI', sans-serif;
+  --goaa-font-auth: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
+  --goaa-fs-body: 15px;
+  --goaa-fs-small: 13px;
+  --goaa-fs-eyebrow: 12px;
+  --goaa-r-card: 14px;
+  --goaa-r-card-lg: 18px;
+  --goaa-r-btn: 9px;
+  --goaa-r-input: 8px;
+  --goaa-r-pill: 999px;
+  --goaa-r-auth-card: 28px;
+  --goaa-r-auth-input: 15px;
+
+  --goaa-rail-w: 260px;
+  --goaa-header-h: 76px;
+  --goaa-gap: 16px;
+  --goaa-page-pad: 24px;
+}
+
+.goaa { background: var(--goaa-bg); color: var(--goaa-text); font-family: var(--goaa-font); font-size: var(--goaa-fs-body); line-height: 1.55; min-height: 100vh; }
+.goaa a { color: var(--goaa-accent-soft); }
+.goaa .goaa-eyebrow { font-size: var(--goaa-fs-eyebrow); letter-spacing: .12em; text-transform: uppercase; color: var(--goaa-muted-2); }
+.goaa .goaa-h1 { font-size: 28px; font-weight: 700; margin: 4px 0 0; letter-spacing: -.01em; }
+.goaa .goaa-h2 { font-size: 20px; font-weight: 700; margin: 0 0 8px; }
+.goaa .goaa-muted { color: var(--goaa-muted); }
+
+/* header */
+.goaa .goaa-header { height: var(--goaa-header-h); margin: 16px var(--goaa-page-pad) 0; padding: 0 28px; display: flex; align-items: center; justify-content: space-between; background: var(--goaa-bg-elev); border: 1px solid var(--goaa-border); border-radius: var(--goaa-r-card-lg); }
+.goaa .goaa-brand { display: flex; align-items: center; gap: 14px; color: var(--goaa-text); text-decoration: none; }
+.goaa .goaa-brand img { width: 44px; height: 44px; border-radius: 50%; }
+.goaa .goaa-brand-text { font-size: 26px; font-weight: 700; letter-spacing: -.01em; }
+
+/* layout */
+.goaa .goaa-layout { display: grid; grid-template-columns: var(--goaa-rail-w) minmax(0, 1fr); gap: var(--goaa-gap); margin: var(--goaa-gap) var(--goaa-page-pad) 40px; }
+.goaa .goaa-layout.goaa-with-aside { grid-template-columns: var(--goaa-rail-w) minmax(0, 1fr) 380px; }
+.goaa .goaa-rail, .goaa .goaa-main, .goaa .goaa-aside { background: var(--goaa-card); border: 1px solid var(--goaa-border); border-radius: var(--goaa-r-card-lg); }
+.goaa .goaa-rail { padding: 20px 14px; align-self: start; position: sticky; top: 16px; }
+.goaa .goaa-main { padding: 24px 28px; min-height: 60vh; }
+.goaa .goaa-aside { padding: 24px; align-self: start; }
+@media (max-width: 1100px) { .goaa .goaa-layout, .goaa .goaa-layout.goaa-with-aside { grid-template-columns: 1fr; } .goaa .goaa-rail { position: static; } }
+
+/* rail */
+.goaa .goaa-rail-cta { display: block; width: 100%; padding: 14px 16px; margin-bottom: 18px; text-align: left; font: inherit; font-size: 17px; color: var(--goaa-text); background: var(--goaa-accent-bg); border: 1px solid var(--goaa-accent-bg-border); border-radius: 12px; cursor: pointer; }
+.goaa .goaa-rail-section { font-size: var(--goaa-fs-eyebrow); letter-spacing: .12em; text-transform: uppercase; color: var(--goaa-muted-2); margin: 8px 8px 10px; }
+.goaa .goaa-rail-item { display: flex; align-items: center; gap: 10px; width: 100%; padding: 12px 14px; margin: 2px 0; font: inherit; font-size: 16px; color: var(--goaa-muted); background: transparent; border: 1px solid transparent; border-radius: 12px; cursor: pointer; text-align: left; text-decoration: none; }
+.goaa .goaa-rail-item:hover { color: var(--goaa-text-2); background: rgba(255,255,255,.04); }
+.goaa .goaa-rail-item[aria-current="page"] { color: var(--goaa-text); background: #17131e; border-color: var(--goaa-border); }
+.goaa .goaa-rail-divider { height: 1px; background: var(--goaa-border); margin: 12px 8px; }
+.goaa .goaa-rail-tag { margin-left: auto; font-size: 10px; letter-spacing: .06em; padding: 2px 7px; border-radius: var(--goaa-r-pill); background: var(--goaa-accent); color: #fff; }
+
+/* cards, buttons, pills, forms */
+.goaa .goaa-card { background: var(--goaa-card); border: 1px solid var(--goaa-border); border-radius: var(--goaa-r-card); padding: 20px; }
+.goaa .goaa-card-2 { background: var(--goaa-card-2); border: 1px solid var(--goaa-border); border-radius: var(--goaa-r-card); padding: 20px; }
+.goaa .goaa-btn { display: inline-flex; align-items: center; gap: 8px; padding: 10px 16px; font: inherit; font-size: 15px; font-weight: 600; border-radius: var(--goaa-r-btn); cursor: pointer; }
+.goaa .goaa-btn-primary { background: var(--goaa-accent); border: 1px solid var(--goaa-accent-border); color: #fff; }
+.goaa .goaa-btn-secondary { background: #17131e; border: 1px solid var(--goaa-border-strong); color: var(--goaa-text-2); }
+.goaa .goaa-btn[disabled] { opacity: .45; cursor: not-allowed; }
+.goaa .goaa-pill { display: inline-block; font-size: 12px; padding: 5px 10px; border-radius: var(--goaa-r-pill); background: var(--goaa-pill); color: var(--goaa-pill-text); }
+.goaa .goaa-pill.ok { background: var(--goaa-ok-bg); color: var(--goaa-ok-text); }
+.goaa .goaa-pill.outline { background: transparent; border: 1px solid var(--goaa-accent-bg-border); color: var(--goaa-accent-soft); }
+.goaa .goaa-input { width: 100%; box-sizing: border-box; padding: 10px 12px; font: inherit; color: var(--goaa-text); background: #0d0b15; border: 1px solid var(--goaa-border-strong); border-radius: var(--goaa-r-input); }
+.goaa .goaa-tabs { display: flex; gap: 6px; flex-wrap: wrap; margin: 12px 0 20px; }
+.goaa .goaa-tab { padding: 10px 16px; font: inherit; font-size: 15px; color: var(--goaa-muted); background: transparent; border: 1px solid transparent; border-radius: var(--goaa-r-btn); cursor: pointer; }
+.goaa .goaa-tab[aria-pressed="true"] { color: #eee4ff; background: var(--goaa-accent-bg); border-color: var(--goaa-accent-bg-border); }
+.goaa .goaa-notice { padding: 12px 14px; margin: 12px 0; border: 1px solid #373040; border-radius: 10px; color: #b6adc4; font-size: 14px; }
+.goaa .goaa-step { display: grid; grid-template-columns: 40px 1fr 20px; align-items: center; gap: 12px; padding: 16px; border: 1px solid var(--goaa-border); border-radius: var(--goaa-r-card); background: var(--goaa-card); }
+.goaa .goaa-step.active { background: #16122a; border-color: var(--goaa-accent-bg-border); }
+.goaa .goaa-step-n { font-size: 13px; color: var(--goaa-muted-2); }
+.goaa .goaa-step-dot { width: 10px; height: 10px; border-radius: 50%; border: 2px solid var(--goaa-accent-soft); }
+.goaa .goaa-step.active .goaa-step-dot { background: var(--goaa-accent-soft); }
+
+/* auth card (mirrors /client-login) */
+.goaa-auth { min-height: 100vh; display: grid; place-items: center; padding: 24px; background: var(--goaa-auth-bg); color: #fff; font-family: var(--goaa-font-auth); }
+.goaa-auth-card { position: relative; width: min(100%, 470px); padding: 34px 34px 30px; border: 1px solid var(--goaa-auth-card-border); background: var(--goaa-auth-card); border-radius: var(--goaa-r-auth-card); box-shadow: 0 30px 90px rgba(0,0,0,.45); }
+.goaa-auth-close { position: absolute; top: 16px; right: 16px; width: 38px; height: 38px; border-radius: 50%; border: 1px solid rgba(255,255,255,.18); background: rgba(255,255,255,.06); color: rgba(255,255,255,.72); cursor: pointer; display: flex; align-items: center; justify-content: center; padding: 0; }
+.goaa-auth-logo { display: block; width: 48px; height: 48px; margin: 0 auto 16px; border-radius: 50%; }
+.goaa-auth-title { margin: 0; text-align: center; font-size: 28px; letter-spacing: -.03em; }
+.goaa-auth-sub { margin: 10px auto 0; text-align: center; color: var(--goaa-auth-muted); font-size: 14px; line-height: 1.6; }
+.goaa-auth-btn { width: 100%; height: 52px; display: inline-flex; align-items: center; justify-content: center; gap: 10px; font: inherit; font-size: 15px; font-weight: 700; color: #fff; background: var(--goaa-auth-btn-bg); border: 1px solid var(--goaa-auth-btn-border); border-radius: var(--goaa-r-pill); cursor: pointer; }
+.goaa-auth-btn.primary { background: var(--goaa-auth-primary-bg); color: var(--goaa-auth-primary-text); border: 0; }
+.goaa-auth-btn[disabled] { opacity: .55; }
+.goaa-auth-input { width: 100%; height: 52px; box-sizing: border-box; padding: 0 16px; font: inherit; font-size: 15px; color: #fff; background: var(--goaa-auth-input-bg); border: 1px solid var(--goaa-auth-input-border); border-radius: var(--goaa-r-auth-input); outline: none; }
+.goaa-auth-or { display: flex; align-items: center; gap: 14px; margin: 24px 0; color: rgba(255,255,255,.46); font-size: 13px; }
+.goaa-auth-or span { height: 1px; flex: 1; background: var(--goaa-auth-hairline); }
+.goaa-auth-link { background: transparent; border: 0; padding: 0; color: #fff; font: inherit; font-size: 14px; text-decoration: underline; text-underline-offset: 3px; cursor: pointer; }
+.goaa-auth-foot { margin: 22px 0 0; text-align: center; font-size: 12px; color: rgba(255,255,255,.45); }
