+/* goaa-pp-compat.css — maps the pp-* content classes still used inside the
+ * real /agent-loop panels onto goaa tokens, so those panels render in the
+ * planning.goaa.ai look without a rewrite. Scoped to .goaa; /portal-preview
+ * keeps its own stylesheet and is unaffected. */
+.goaa .pp-stack { display: grid; gap: 16px; }
+.goaa .pp-panel { background: var(--goaa-card-2); border: 1px solid var(--goaa-border); border-radius: var(--goaa-r-card); padding: 20px; }
+.goaa .pp-panel-inner { background: var(--goaa-card); border: 1px solid var(--goaa-border); border-radius: 12px; padding: 16px; }
+.goaa .pp-section-head { display: flex; justify-content: space-between; align-items: flex-start; gap: 16px; margin-bottom: 14px; }
+.goaa .pp-h1 { font-size: 24px; font-weight: 700; margin: 0 0 6px; letter-spacing: -.01em; }
+.goaa .pp-h2 { font-size: 20px; font-weight: 700; margin: 0 0 8px; }
+.goaa .pp-h3 { font-size: 16px; font-weight: 700; margin: 0 0 6px; }
+.goaa .pp-body { margin: 0 0 14px; line-height: 1.6; }
+.goaa .pp-muted { color: var(--goaa-muted); }
+.goaa .pp-mono { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 13px; }
+.goaa .pp-label { font-size: var(--goaa-fs-eyebrow); letter-spacing: .08em; text-transform: uppercase; color: var(--goaa-muted-2); margin: 12px 0 4px; }
+.goaa .pp-inline-label { font-size: 13px; color: var(--goaa-muted); }
+.goaa .pp-inline-hint, .goaa .pp-footnote { font-size: 13px; color: var(--goaa-muted-2); }
+.goaa .pp-note { padding: 12px 14px; margin: 12px 0; border: 1px solid #373040; border-radius: 10px; color: #b6adc4; font-size: 14px; }
