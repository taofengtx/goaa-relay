+"""Project Context store + router  (ADD-ONLY, 2026-09-14, Aika-Box).
+
+Adds the three-layer development context requested by Tao:
+    Project  ->  Chief Engineer (總工)  ->  Workers  ->  Task / Session
+
+Scope of this module (deliberately narrow):
+  * File-backed JSON store (NO DB schema change).
+  * New routes only, mounted at ``/api/projects/*``.
+  * Does NOT touch QwenPaw session/approval semantics, auth, or the Golden :5188.
+
+Honesty rule (§9 of the brief): a Chief Engineer is only ever shown as
+CONFIGURED / "Connection: Not Yet Bound" unless a real machine-to-machine
+bridge exists.  No bridge exists today, so ``connected`` is False for all.
+"""
+from __future__ import annotations
+
+import json
+import os
+import sys
+import threading
+import time
+import uuid
+from typing import Any
+
+sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
+
+from fastapi import APIRouter, Cookie, Depends, HTTPException  # noqa: E402
+from pydantic import BaseModel, Field  # noqa: E402
+
+import auth  # noqa: E402  (shared local-console auth module)
+
+COOKIE_NAME = "goaa_console_session"
+STORE_PATH = os.environ.get("GOAA_PROJECTS_FILE", "/tmp/ui-projects.json")
+
+router = APIRouter(prefix="/api/projects", tags=["projects"])
+
+# Chief Engineer catalogue.  ``connected`` is intentionally HONEST — there is no
+# real machine-to-machine Chief Engineer bridge wired up yet.
+CHIEF_ENGINEERS: list[dict[str, Any]] = [
+    {"id": "chatgpt", "name": "ChatGPT", "connected": False},
+    {"id": "claude", "name": "Claude", "connected": False},
+    {"id": "other", "name": "Other / Future", "connected": False},
+]
+CHIEF_IDS = {c["id"] for c in CHIEF_ENGINEERS}
+
+# Project Document registry types (metadata only; no upload / no file read).
+DOC_TYPES: list[str] = [
+    "Requirement",
+    "Architecture",
+    "Development Spec",
+    "Handoff",
+    "Test Report",
+    "Other",
+]
+DOC_TYPE_SET = set(DOC_TYPES)
+
+DEFAULT_PROJECT_ID = "proj_goaa_ai"
+
+_lock = threading.RLock()
+
+
+def _now() -> str:
+    return time.strftime("%Y-%m-%dT%H:%M:%S%z")
+
+
+def _seed() -> dict[str, Any]:
+    ts = _now()
+    return {
+        "version": 1,
+        "active_project_id": DEFAULT_PROJECT_ID,
+        "projects": [
+            {
+                "project_id": DEFAULT_PROJECT_ID,
+                "name": "GOAA.ai",
+                # ``description`` is deliberately EMPTY in the seed: the brief
+                # forbids hard-coding the official project blurb.  Tao edits it
+                # through the "專案詳情" panel and it is persisted here.
+                "description": "",
+                "objective": "",
+                "stage": "",
+                "chief_engineer": "chatgpt",
+                # null == "not configured yet" => UI treats as ALL registered workers.
+                "selected_workers": None,
+                # Project Document REGISTRY (references/metadata only — no file I/O).
+                "documents": [],
+                "created_at": ts,
+                "updated_at": ts,
+                "status": "active",
+            }
+        ],
+        "task_context": {},
+    }
+
+
+def _save(data: dict[str, Any]) -> None:
+    with _lock:
+        tmp = STORE_PATH + ".tmp"
+        with open(tmp, "w", encoding="utf-8") as fh:
+            json.dump(data, fh, ensure_ascii=False, indent=2)
+        os.replace(tmp, STORE_PATH)
+
+
+def _load() -> dict[str, Any]:
+    with _lock:
+        data: Any = None
+        if os.path.exists(STORE_PATH):
+            try:
+                with open(STORE_PATH, "r", encoding="utf-8") as fh:
+                    data = json.load(fh)
+            except Exception:
+                data = None
+        if not isinstance(data, dict) or not isinstance(data.get("projects"), list) or not data["projects"]:
+            data = _seed()
+            _save(data)
+            return data
+        data.setdefault("active_project_id", data["projects"][0]["project_id"])
+        data.setdefault("task_context", {})
+        for proj in data["projects"]:
+            _normalize_project(proj)
+        return data
+
+
+def _normalize_project(proj: dict[str, Any]) -> dict[str, Any]:
+    """Forward-compatible defaults (older stores keep working — no DB, no migration script)."""
+    proj.setdefault("name", "Untitled")
+    proj.setdefault("description", "")
+    proj.setdefault("objective", "")
+    proj.setdefault("stage", "")
+    proj.setdefault("chief_engineer", "chatgpt")
+    proj.setdefault("selected_workers", None)
+    docs = proj.get("documents")
+    if not isinstance(docs, list):
+        docs = []
+    proj["documents"] = docs
+    for doc in docs:
+        if not isinstance(doc, dict):
+            continue
+        doc.setdefault("document_id", "doc_" + uuid.uuid4().hex[:8])
+        doc.setdefault("project_id", proj.get("project_id"))
+        doc.setdefault("title", "Untitled")
+        doc.setdefault("type", "Other")
+        doc.setdefault("source", "")
+        doc.setdefault("reference", "")
+        doc.setdefault("description", "")
+        doc.setdefault("created_at", "")
+        doc.setdefault("updated_at", doc.get("created_at", ""))
+    return proj
+
+
+def _derive_source(reference: str) -> str:
+    ref = (reference or "").strip()
+    if not ref:
+        return "note"
+    low = ref.lower()
+    if low.startswith("http://") or low.startswith("https://"):
+        return "url"
+    if ref.startswith("/") or ":" in ref[:4]:
+        return "path"
+    return "other"
+
+
+def _find(data: dict[str, Any], pid: str) -> dict[str, Any] | None:
+    for proj in data["projects"]:
+        if proj.get("project_id") == pid:
+            return proj
+    return None
+
+
+def require_session(session_cookie: str | None = Cookie(default=None, alias=COOKIE_NAME)) -> dict[str, Any]:
+    user = auth.verify_session(session_cookie) if session_cookie else None
+    if not user:
+        raise HTTPException(status_code=401, detail="authentication required")
+    return user
+
+
+class ProjectCreate(BaseModel):
+    name: str = Field(min_length=1, max_length=80)
+    description: str = ""
+
+
+class ProjectUpdate(BaseModel):
+    name: str | None = None
+    description: str | None = None
+    objective: str | None = None
+    stage: str | None = None
+    chief_engineer: str | None = None
+    selected_workers: list[str] | None = None
+
+
+class DocumentCreate(BaseModel):
+    """Project Document REGISTRY entry — stores a reference/metadata, never file content."""
+
+    title: str = Field(min_length=1, max_length=200)
+    type: str = "Other"
+    source: str = ""
+    reference: str = ""
+    description: str = ""
+
+
+class TaskBind(BaseModel):
+    session_id: str = Field(min_length=1)
+    project_id: str = ""
+    chief_engineer: str = ""
+    worker_scope: list[str] | None = None
+
+
+def _public(data: dict[str, Any]) -> dict[str, Any]:
+    return {
+        "ok": True,
+        "active_project_id": data.get("active_project_id"),
+        "projects": data.get("projects", []),
+        "chief_engineers": [
+            {
+                "id": c["id"],
+                "name": c["name"],
+                "status": "CONFIGURED",
+                "connection": "BOUND" if c["connected"] else "NOT CONNECTED",
+            }
+            for c in CHIEF_ENGINEERS
+        ],
+        "task_context": data.get("task_context", {}),
+        "document_types": DOC_TYPES,
+    }
+
+
+@router.get("")
+def list_projects(user: dict = Depends(require_session)) -> dict[str, Any]:
+    return _public(_load())
+
+
+@router.post("")
+def create_project(req: ProjectCreate, user: dict = Depends(require_session)) -> dict[str, Any]:
+    data = _load()
+    ts = _now()
+    pid = "proj_" + uuid.uuid4().hex[:8]
+    data["projects"].append(
+        {
+            "project_id": pid,
+            "name": req.name.strip() or "Untitled",
+            "description": req.description,
+            "objective": "",
+            "stage": "",
+            "chief_engineer": "chatgpt",
+            "selected_workers": None,
+            "documents": [],
+            "created_at": ts,
+            "updated_at": ts,
+            "status": "active",
+        }
+    )
+    data["active_project_id"] = pid
+    _save(data)
+    return _public(data)
+
+
+@router.put("/{project_id}")
+def update_project(project_id: str, req: ProjectUpdate, user: dict = Depends(require_session)) -> dict[str, Any]:
+    data = _load()
+    proj = _find(data, project_id)
+    if not proj:
+        raise HTTPException(status_code=404, detail="unknown project")
+    if req.name is not None and req.name.strip():
+        proj["name"] = req.name.strip()
+    if req.description is not None:
+        proj["description"] = req.description
+    if req.objective is not None:
+        proj["objective"] = req.objective
+    if req.stage is not None:
+        proj["stage"] = req.stage
+    if req.chief_engineer is not None:
+        if req.chief_engineer not in CHIEF_IDS:
+            raise HTTPException(status_code=400, detail="unknown chief engineer")
+        proj["chief_engineer"] = req.chief_engineer
+    if req.selected_workers is not None:
+        proj["selected_workers"] = list(dict.fromkeys(req.selected_workers))
+    proj["updated_at"] = _now()
+    _save(data)
+    return _public(data)
+
+
+@router.post("/{project_id}/activate")
+def activate_project(project_id: str, user: dict = Depends(require_session)) -> dict[str, Any]:
+    data = _load()
+    if not _find(data, project_id):
+        raise HTTPException(status_code=404, detail="unknown project")
+    data["active_project_id"] = project_id
+    _save(data)
+    return _public(data)
+
+
+# ── Project Documents (REGISTRY ONLY: references/metadata, no file I/O) ──
+@router.get("/{project_id}/documents")
+def list_documents(project_id: str, user: dict = Depends(require_session)) -> dict[str, Any]:
+    data = _load()
+    proj = _find(data, project_id)
+    if not proj:
+        raise HTTPException(status_code=404, detail="unknown project")
+    return {"ok": True, "project_id": project_id, "documents": proj["documents"]}
+
+
+@router.post("/{project_id}/documents")
+def add_document(
+    project_id: str, req: DocumentCreate, user: dict = Depends(require_session)
+) -> dict[str, Any]:
+    data = _load()
+    proj = _find(data, project_id)
+    if not proj:
+        raise HTTPException(status_code=404, detail="unknown project")
+    dtype = req.type if req.type in DOC_TYPE_SET else "Other"
+    ts = _now()
+    doc = {
+        "document_id": "doc_" + uuid.uuid4().hex[:8],
+        "project_id": project_id,
+        "title": req.title.strip() or "Untitled",
+        "type": dtype,
+        "source": (req.source or "").strip() or _derive_source(req.reference),
+        "reference": (req.reference or "").strip(),
+        "description": req.description or "",
+        "created_at": ts,
+        "updated_at": ts,
+    }
+    proj["documents"].append(doc)
+    proj["updated_at"] = ts
+    _save(data)
+    return {"ok": True, "document": doc, "projects": data["projects"],
+            "active_project_id": data["active_project_id"]}
+
+
+# ── Task / Session context binding (does NOT touch the QwenPaw session API) ──
+@router.get("/tasks/all")
+def list_task_context(user: dict = Depends(require_session)) -> dict[str, Any]:
+    return {"ok": True, "task_context": _load().get("task_context", {})}
+
+
+@router.post("/tasks")
+def bind_task(req: TaskBind, user: dict = Depends(require_session)) -> dict[str, Any]:
+    data = _load()
+    pid = req.project_id or data.get("active_project_id")
+    proj = _find(data, pid) or {}
+    ctx = {
+        "project_id": pid,
+        "project_name": proj.get("name", ""),
+        "chief_engineer": req.chief_engineer or proj.get("chief_engineer", ""),
+        "worker_scope": req.worker_scope if req.worker_scope is not None else (proj.get("selected_workers") or []),
+        # REFERENCE ONLY (ids/titles) — document bodies are never pushed into a prompt here.
+        "project_documents": [
+            {"document_id": d.get("document_id"), "title": d.get("title"), "type": d.get("type")}
+            for d in proj.get("documents", [])
+        ],
+        "created_at": _now(),
+    }
+    data.setdefault("task_context", {})[req.session_id] = ctx
+    _save(data)
+    return {"ok": True, "session_id": req.session_id, "context": ctx}
